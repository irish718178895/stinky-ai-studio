import {
  comfyFetch,
  generateForProject
} from "../../services/comfyui.js";

function removeUndefinedValues(values = {}) {
  return Object.fromEntries(
    Object.entries(values).filter(
      ([, value]) => value !== undefined
    )
  );
}

export const comfyuiProvider = {
  id: "comfyui",
  type: "image",
  name: "ComfyUI",
  version: "1.0",

  settingsSchema: [
    {
      key: "checkpoint",
      label: "Checkpoint",
      type: "text",
      default: "dreamshaper_8.safetensors"
    },
    {
      key: "sampler",
      label: "Sampler",
      type: "text",
      default: "euler"
    },
    {
      key: "scheduler",
      label: "Scheduler",
      type: "text",
      default: "normal"
    },
    {
      key: "steps",
      label: "Steps",
      type: "number",
      default: 20,
      min: 1,
      max: 100,
      step: 1
    },
    {
      key: "cfg",
      label: "CFG",
      type: "number",
      default: 7,
      min: 1,
      max: 30,
      step: 0.5
    }
  ],

  capabilities: Object.freeze([
    "txt2img",
    "img2img",
    "batch",
    "seed",
    "negative-prompt"
  ]),

  supports: Object.freeze({
    gpu: true,
    cpu: false,
    local: true,
    remote: true
  }),

  async health() {
    try {
      await comfyFetch("/system_stats");

      return {
        available: true,
        provider: "comfyui"
      };
    } catch (error) {
      return {
        available: false,
        provider: "comfyui",
        error: error.message
      };
    }
  },

  async generate(
    projects,
    project,
    settings = {},
    sourceImageId = null
  ) {
    const projectSettings = {
      ...(project.providerSettings?.[this.id] || {})
    };

    const requestSettings =
      removeUndefinedValues(settings);

    const mergedSettings = {
      ...projectSettings,
      ...requestSettings
    };

    return generateForProject(
      projects,
      project,
      mergedSettings,
      sourceImageId
    );
  }
};
