const CAMERA_MOVEMENTS = [
  "none",
  "zoom-in",
  "zoom-out",
  "pan-left",
  "pan-right"
];

function extractJson(text) {
  const trimmed = String(text || "").trim();

  try {
    return JSON.parse(trimmed);
  } catch {}

  const fenced = trimmed.match(/```(?:json)?\s*([\s\S]*?)```/i);

  if (fenced) {
    try {
      return JSON.parse(fenced[1].trim());
    } catch {}
  }

  const first = trimmed.indexOf("{");
  const last = trimmed.lastIndexOf("}");

  if (first >= 0 && last > first) {
    try {
      return JSON.parse(trimmed.slice(first, last + 1));
    } catch {}
  }

  throw new Error(
    "The local model did not return valid JSON. Try again or use a different Ollama model."
  );
}

function normalizeScene(
  scene,
  index,
  defaultDuration,
  style = "cinematic"
) {
  const requestedCameraMovement = String(
    scene?.cameraMovement || ""
  ).trim();

  const cameraMovement = CAMERA_MOVEMENTS.includes(
    requestedCameraMovement
  )
    ? requestedCameraMovement
    : CAMERA_MOVEMENTS[index % CAMERA_MOVEMENTS.length];

  const title = String(
    scene?.title || `Scene ${index + 1}`
  )
    .trim()
    .slice(0, 100);

  const description = String(
    scene?.description ||
    scene?.visualNotes ||
    ""
  )
    .trim()
    .slice(0, 500);

  const narration = String(
    scene?.narration || ""
  )
    .trim()
    .slice(0, 2000);

  const generatedImagePrompt = [
    description,
    title,
    style || "cinematic",
    "detailed still image",
    "no text",
    "no logo",
    "no watermark"
  ]
    .filter(Boolean)
    .join(", ");

  const imagePrompt = String(
    scene?.imagePrompt ||
    scene?.prompt ||
    generatedImagePrompt
  )
    .trim()
    .slice(0, 4000);

  const duration = Math.min(
    15,
    Math.max(
      2,
      Number(scene?.duration) || defaultDuration
    )
  );

  return {
    title,
    description,
    narration,
    imagePrompt,
    duration,
    cameraMovement
  };
}

export async function generateStoryboard({
  ollamaUrl,
  model,
  temperature = 0.7,
  idea,
  length,
  style,
  audience
}) {
  const cleanOllamaUrl = String(
    ollamaUrl || ""
  )
    .trim()
    .replace(/\/$/, "");

  const cleanModel = String(
    model || ""
  ).trim();

  const cleanIdea = String(
    idea || ""
  ).trim();

  if (!cleanOllamaUrl) {
    throw new Error(
      "Ollama URL is required."
    );
  }

  if (!cleanModel) {
    throw new Error(
      "An Ollama model is required."
    );
  }

  if (!cleanIdea) {
    throw new Error(
      "A storyboard idea is required."
    );
  }

  const targetSeconds = [15, 30, 60].includes(
    Number(length)
  )
    ? Number(length)
    : 30;

  const sceneCount =
    targetSeconds === 15
      ? 3
      : targetSeconds === 60
        ? 8
        : 5;

  const defaultDuration =
    targetSeconds / sceneCount;

  const system = `Return only valid JSON with this exact shape:
{"title":"","summary":"","scenes":[{"title":"","description":"","narration":"","duration":5}]}

Rules:
- Use exactly ${sceneCount} scenes.
- Total duration should be about ${targetSeconds} seconds.
- Keep every description under 35 words.
- Keep every narration under 25 words.
- Do not include markdown.
- Do not include explanations.
- Do not include captions, logos, watermarks, or visible text in scene descriptions.`;

  const prompt = `Create a ${targetSeconds}-second ${
    style || "cinematic"
  } storyboard.

Idea: ${cleanIdea}
Audience: ${audience || "general audience"}

Keep it simple, visually clear, and practical for one still image per scene.`;

  const controller = new AbortController();

  const timeout = setTimeout(
    () => controller.abort(),
    3 * 60 * 1000
  );

  let response;

  try {
    response = await fetch(
      `${cleanOllamaUrl}/api/chat`,
      {
        method: "POST",

        headers: {
          "Content-Type": "application/json"
        },

        signal: controller.signal,

        body: JSON.stringify({
          model: cleanModel,
          stream: false,
          format: "json",
          keep_alive: "5m",

          messages: [
            {
              role: "system",
              content: system
            },
            {
              role: "user",
              content: prompt
            }
          ],

          options: {
            temperature,
            num_predict: 300,
            num_ctx: 4096
          }
        })
      }
    );
  } catch (error) {
    console.error(
      "Ollama storyboard request failed:",
      error
    );

    const details = [
      error?.name,
      error?.message,
      error?.cause?.code,
      error?.cause?.message
    ]
      .filter(Boolean)
      .join(": ");

    if (
      error?.name === "AbortError" ||
      error?.name === "TimeoutError"
    ) {
      throw new Error(
        `Ollama storyboard generation exceeded 3 minutes using model "${cleanModel}".`
      );
    }

    throw new Error(
      `Ollama request failed at ${cleanOllamaUrl} using model "${cleanModel}": ${
        details || String(error)
      }`
    );
  } finally {
    clearTimeout(timeout);
  }

  if (!response.ok) {
    const body = await response.text();

    throw new Error(
      `Ollama ${response.status}: ${
        body || response.statusText
      }`
    );
  }

  let payload;

  try {
    payload = await response.json();
  } catch (error) {
    throw new Error(
      `Ollama returned an unreadable response: ${error.message}`
    );
  }

  const modelOutput =
    payload?.message?.content ||
    payload?.response ||
    "";

  const parsed = extractJson(modelOutput);

  if (
    !Array.isArray(parsed.scenes) ||
    parsed.scenes.length === 0
  ) {
    throw new Error(
      "Ollama returned no storyboard scenes."
    );
  }

  const scenes = parsed.scenes
    .slice(0, sceneCount)
    .map((scene, index) =>
      normalizeScene(
        scene,
        index,
        defaultDuration,
        style
      )
    );

  const totalDuration = scenes.reduce(
    (sum, scene) =>
      sum + scene.duration,
    0
  );

  if (
    totalDuration > 0 &&
    Math.abs(
      totalDuration - targetSeconds
    ) > 1
  ) {
    const factor =
      targetSeconds / totalDuration;

    scenes.forEach(scene => {
      scene.duration = Math.max(
        2,
        Math.round(
          scene.duration * factor * 2
        ) / 2
      );
    });
  }

  return {
    title: String(
      parsed.title || "AI Storyboard"
    )
      .trim()
      .slice(0, 100),

    summary: String(
      parsed.summary || ""
    )
      .trim()
      .slice(0, 500),

    scenes
  };
}
